diff --git a/cf/src/connection.js b/cf/src/connection.js
index 8e79170aeb13efe8c3c77ccede0cd3a115b5e1b5..0fd5ade8a89a5cb464d4fd6db02c85b4bb5b16e4 100644
--- a/cf/src/connection.js
+++ b/cf/src/connection.js
@@ -159,6 +159,13 @@ function Connection(options, queues = {}, { onopen = noop, onend = noop, onclose
     if (terminated)
       return queryError(q, Errors.connection('CONNECTION_DESTROYED', options))
 
+    // ScadBuddy #3294: a query on a connection the server has closed (a transaction's
+    // ROLLBACK or COMMIT after its backend was terminated) would otherwise reach
+    // nextWrite with no socket and throw from setImmediate, uncaught. It fails as the
+    // connection did; true keeps the closed connection out of the `full` queue.
+    if (!socket)
+      return (queryError(q, Errors.connection('CONNECTION_CLOSED', options)), true)
+
     if (stream)
       return queryError(q, Errors.generic('COPY_IN_PROGRESS', 'You cannot execute queries during copy'))
 
