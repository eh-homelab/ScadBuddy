{
  "name": "scadbuddy-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('../plugins/scadbuddy/skills/authoring/SKILL.md', 'dist/docs/authoring.md')\" && node scripts/bundle-workflows.mjs",
    "prebuild": "pnpm gen:api && node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "start": "node --import ./dist/telemetry.js dist/main.js",
    "lint": "eslint . && cd .. && agent/node_modules/.bin/eslint --config agent/eslint.config.js scripts/gen-api-request-defaults.mjs",
    "pretypecheck": "pnpm gen:api",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "pnpm gen:api",
    "test": "vitest run",
    "test:watch": "vitest",
    "evals": "vitest run --config vitest.evals.config.ts",
    "gen:api": "node scripts/gen-api.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.314",
    "@anthropic-ai/sdk": "^1.3.0",
    "@hono/node-server": "^2.1.6",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/core": "3.1.1",
    "@opentelemetry/exporter-trace-otlp-proto": "0.301.0",
    "@opentelemetry/instrumentation": "0.301.2",
    "@opentelemetry/instrumentation-http": "0.301.2",
    "@opentelemetry/resources": "3.1.0",
    "@opentelemetry/sdk-node": "0.301.2",
    "@opentelemetry/sdk-trace": "3.1.1",
    "@temporalio/activity": "1.25.0",
    "@temporalio/client": "1.25.0",
    "@temporalio/common": "1.25.0",
    "@temporalio/worker": "1.25.0",
    "@temporalio/workflow": "1.25.0",
    "cron-parser": "5.10.5",
    "hono": "^4.13.16",
    "jose": "^6.2.17",
    "openapi-fetch": "^0.17.0",
    "postgres": "^3.4.9",
    "quickjs-emscripten": "0.32.0",
    "turndown": "7.2.5",
    "undici": "8.12.4",
    "ws": "^8.23.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@opentelemetry/context-async-hooks": "3.1.0",
    "@temporalio/testing": "1.25.0",
    "@types/node": "^24.19.2",
    "@types/turndown": "5.0.6",
    "@types/ws": "^8.18.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "msw": "^3.0.3",
    "openapi-typescript": "^7.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.1"
  }
}
