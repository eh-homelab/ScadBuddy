{
  "name": "scadbuddy-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src/db/migrations', 'dist/db/migrations', { recursive: true }); require('node:fs').cpSync('../plugins/scadbuddy/skills/authoring/SKILL.md', 'dist/docs/authoring.md')\" && node dist/export-tools.js dist/tools.json && node scripts/bundle-workflows.mjs",
    "prebuild": "pnpm gen:api && node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "pretypecheck": "pnpm gen:api",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "pnpm gen:api",
    "test": "vitest run",
    "test:watch": "vitest",
    "evals": "vitest run --config vitest.evals.config.ts",
    "gen:api": "node scripts/gen-api.mjs",
    "gen:vectors": "tsc -p tsconfig.vectors.json && node dist/vectors-gen/scripts/gen-secret-vectors.js",
    "gen:tools": "pnpm build && node dist/export-tools.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.283",
    "@anthropic-ai/sdk": "^0.128.0",
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@playwright/mcp": "0.0.82",
    "@temporalio/activity": "1.24.0",
    "@temporalio/client": "1.24.0",
    "@temporalio/common": "1.24.0",
    "@temporalio/proto": "1.24.0",
    "@temporalio/worker": "1.24.0",
    "@temporalio/workflow": "1.24.0",
    "hono": "^4.13.9",
    "jose": "^6.2.12",
    "openapi-fetch": "^0.17.0",
    "postgres": "^3.4.9",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@temporalio/testing": "1.24.0",
    "@types/node": "^24.19.0",
    "@types/ws": "^8.18.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
