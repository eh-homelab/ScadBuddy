{
  "permissions": {
    "allow": [
      "Skill(project-ops:find-work)"
    ]
  },
  "enabledPlugins": {
    "project-ops@wonderforgelabs-project-ops": true,
    "gh-stack@wonderforgelabs-project-ops": true
  },
  "extraKnownMarketplaces": {
    "wonderforgelabs-project-ops": {
      "source": {
        "source": "github",
        "repo": "WonderForgeLabs/project-ops"
      },
      "autoUpdate": true
    }
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.github/scripts/plugin-edited.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
