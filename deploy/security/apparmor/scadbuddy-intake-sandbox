# The intake sandbox's AppArmor profile (eh-homelab/ScadBuddy#6133, #6779).
# Its launcher (ScadBuddy backend/scadbuddy/intake_worker/confine.py) parses
# each customer file in new user, network, mount and PID namespaces.
# apparmor-loader.yaml loads it on every amd64 node. The source is ScadBuddy
# deploy/security/apparmor/scadbuddy-intake-sandbox (the same bytes).
#
# It is containerd's default AppArmor profile (cri-containerd.apparmor.d, the
# template in containerd v2.2.7 contrib/apparmor/template.go:
# https://github.com/containerd/containerd/blob/v2.2.7/contrib/apparmor/template.go)
# on ABI 4.0, with `userns,` and the launcher's own mounts in place of
# `deny mount,`: / made private, an empty tmpfs over the RPC token's
# directory, /dev/shm, the spool and /proc, and a bind of the check's box. No
# other mount and no pivot_root. The nodes run
# kernel.apparmor_restrict_unprivileged_userns=1
# (https://gitlab.com/apparmor/apparmor/-/wikis/unprivileged_userns_restriction).
# Measured on a GitHub-hosted ubuntu-24.04 runner with that sysctl at 1
# (ScadBuddy docs/security/trust-boundaries.md, "Browser and parser pod
# profiles"): the sandbox starts and answers a check under this profile and
# the seccomp file intake-sandbox.json, and exits 3 ("mount(MS_REC |
# MS_PRIVATE): Permission denied") when the mount rules are replaced by
# `deny mount,`.
abi <abi/4.0>,

#include <tunables/global>

profile scadbuddy-intake-sandbox flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network,
  capability,
  file,
  umount,
  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=crun,
  signal (send,receive) peer=scadbuddy-intake-sandbox,

  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9],[^1-9][^0-9],[^1-9s][^0-9y][^0-9s],[^1-9][^0-9][^0-9][^0-9]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/mem rwklx,
  deny @{PROC}/kmem rwklx,
  deny @{PROC}/kcore rwklx,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  ptrace (trace,tracedby,read,readby) peer=scadbuddy-intake-sandbox,

  userns,
  mount options=(rw, rprivate) -> /,
  mount fstype=tmpfs options=(rw, nosuid, nodev, noexec) tmpfs -> /etc/scadbuddy-intake-rpc/,
  mount fstype=tmpfs options=(rw, nosuid, nodev, noexec) tmpfs -> /dev/shm/,
  mount fstype=tmpfs options=(rw, nosuid, nodev, noexec) tmpfs -> /var/lib/scadbuddy-intake/,
  mount fstype=tmpfs options=(rw, nosuid, nodev, noexec) tmpfs -> /proc/,
  mount options=(rw, bind) -> /var/lib/scadbuddy-intake/box/,
}
