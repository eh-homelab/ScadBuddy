{
  "uid": "scadbuddy-printing",
  "title": "ScadBuddy / Printing, Bambuddy and storage",
  "description": "Print routes, every call to Bambuddy (by scope), the blob store, the worker cache, uploads and printer camera recording.",
  "tags": ["scadbuddy"],
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 42,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "1m",
  "links": [
    {
      "type": "dashboards",
      "title": "ScadBuddy",
      "tags": ["scadbuddy"],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "icon": "external link",
      "tooltip": "",
      "url": ""
    }
  ],
  "annotations": { "list": [] },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "prometheus" },
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "options": []
      },
      {
        "name": "DS_TEMPO",
        "label": "Tempo",
        "description": "Trace panels need a Tempo datasource (clusters#1596 Phase 4); until one exists they show no data and the metric panels are unaffected.",
        "type": "datasource",
        "query": "tempo",
        "current": { "text": "Tempo", "value": "tempo" },
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "options": []
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(scadbuddy_build_info, namespace)",
        "query": {
          "query": "label_values(scadbuddy_build_info, namespace)",
          "refId": "namespace"
        },
        "current": { "text": "bambuddy", "value": "bambuddy" },
        "includeAll": false,
        "hide": 0,
        "refresh": 2,
        "regex": "",
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Print routes",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Mean latency",
      "description": "Mean request time for the print, prints and farm routes (most proxy Bambuddy).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 1, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "topk(10, sum by (method, route) (rate(scadbuddy_http_request_duration_seconds_sum{namespace=\"$namespace\", route!=\"other\", route=~\"(/api/v1)?/(print|prints|farm)(/.*)?\"}[$__rate_interval])) / sum by (method, route) (rate(scadbuddy_http_request_duration_seconds_count{namespace=\"$namespace\", route!=\"other\", route=~\"(/api/v1)?/(print|prints|farm)(/.*)?\"}[$__rate_interval])))",
          "legendFormat": "{{method}} {{route}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Errors",
      "description": "4xx/5xx responses per second on those routes. A 502/504 there is usually Bambuddy.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 8, "y": 1, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (route, status) (rate(scadbuddy_http_requests_total{namespace=\"$namespace\", route!=\"other\", route=~\"(/api/v1)?/(print|prints|farm)(/.*)?\", status=~\"[45]..\"}[$__rate_interval]))",
          "legendFormat": "{{status}} {{route}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Prints followed",
      "description": "Prints this process is following (FollowPrint attempts).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 16, "y": 1, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "max(scadbuddy_print_follows_running{namespace=\"$namespace\"})",
          "legendFormat": "following"
        }
      ]
    },
    {
      "id": 5,
      "type": "row",
      "title": "Bambuddy calls",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 9, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 6,
      "type": "table",
      "title": "Slowest Bambuddy calls (API)",
      "description": "Calls the API made to Bambuddy (bambuddy.<operation> client spans), with their scope and status. Tempo search returns recent matches, not the slowest of the whole range: sort by Duration to find the worst of them. Needs the Tempo datasource (clusters#1596 Phase 4).",
      "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
      "gridPos": { "x": 0, "y": 10, "w": 8, "h": 8 },
      "options": { "sortBy": [{ "displayName": "Duration", "desc": true }] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
          "queryType": "traceql",
          "query": "{resource.service.name=\"scadbuddy-api\" && kind=client && span.scadbuddy.bambuddy.scope != nil} | select(span.scadbuddy.bambuddy.scope, span.http.request.method, span.http.response.status_code)",
          "limit": 20,
          "spss": 3,
          "tableType": "spans"
        }
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Failed Bambuddy calls (API)",
      "description": "Bambuddy calls with status error, by scope: a 401/403 names the scope the key lacks. Tempo search returns recent matches, not the slowest of the whole range: sort by Duration to find the worst of them. Needs the Tempo datasource (clusters#1596 Phase 4).",
      "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
      "gridPos": { "x": 8, "y": 10, "w": 8, "h": 8 },
      "options": { "sortBy": [{ "displayName": "Duration", "desc": true }] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
          "queryType": "traceql",
          "query": "{resource.service.name=\"scadbuddy-api\" && kind=client && span.scadbuddy.bambuddy.scope != nil && status=error} | select(span.scadbuddy.bambuddy.scope, span.http.request.method, span.http.response.status_code)",
          "limit": 20,
          "spss": 3,
          "tableType": "spans"
        }
      ]
    },
    {
      "id": 8,
      "type": "table",
      "title": "Bambuddy calls over 2 s (API)",
      "description": "Bambuddy calls that took longer than 2 s: the photo and thumbnail proxies (#2289) show here. Tempo search returns recent matches, not the slowest of the whole range: sort by Duration to find the worst of them. Needs the Tempo datasource (clusters#1596 Phase 4).",
      "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
      "gridPos": { "x": 16, "y": 10, "w": 8, "h": 8 },
      "options": { "sortBy": [{ "displayName": "Duration", "desc": true }] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
          "queryType": "traceql",
          "query": "{resource.service.name=\"scadbuddy-api\" && kind=client && span.scadbuddy.bambuddy.scope != nil && duration > 2s} | select(span.scadbuddy.bambuddy.scope, span.http.request.method, span.http.response.status_code)",
          "limit": 20,
          "spss": 3,
          "tableType": "spans"
        }
      ]
    },
    {
      "id": 9,
      "type": "table",
      "title": "Slowest Bambuddy calls (worker)",
      "description": "Bambuddy calls from the worker: the blob store's Bambuddy backend and print activities. Tempo search returns recent matches, not the slowest of the whole range: sort by Duration to find the worst of them. Needs the Tempo datasource (clusters#1596 Phase 4). A deployment whose API runs the print worker in process (SCADBUDDY_TEMPORAL_WORKER_INPROCESS or SCADBUDDY_TEMPORAL_PRINT_WORKER_INPROCESS) reports these calls as scadbuddy-api, among the API's own, so they are not shown here.",
      "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
      "gridPos": { "x": 0, "y": 18, "w": 8, "h": 8 },
      "options": { "sortBy": [{ "displayName": "Duration", "desc": true }] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
          "queryType": "traceql",
          "query": "{resource.service.name=\"scadbuddy-print\" && kind=client && span.scadbuddy.bambuddy.scope != nil} | select(span.scadbuddy.bambuddy.scope, span.http.request.method, span.http.response.status_code)",
          "limit": 20,
          "spss": 3,
          "tableType": "spans"
        }
      ]
    },
    {
      "id": 10,
      "type": "table",
      "title": "Failed Bambuddy calls (worker)",
      "description": "Worker-side Bambuddy calls with status error. Tempo search returns recent matches, not the slowest of the whole range: sort by Duration to find the worst of them. Needs the Tempo datasource (clusters#1596 Phase 4). A deployment whose API runs the print worker in process (SCADBUDDY_TEMPORAL_WORKER_INPROCESS or SCADBUDDY_TEMPORAL_PRINT_WORKER_INPROCESS) reports these calls as scadbuddy-api, among the API's own, so they are not shown here.",
      "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
      "gridPos": { "x": 8, "y": 18, "w": 8, "h": 8 },
      "options": { "sortBy": [{ "displayName": "Duration", "desc": true }] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
          "queryType": "traceql",
          "query": "{resource.service.name=\"scadbuddy-print\" && kind=client && span.scadbuddy.bambuddy.scope != nil && status=error} | select(span.scadbuddy.bambuddy.scope, span.http.request.method, span.http.response.status_code)",
          "limit": 20,
          "spss": 3,
          "tableType": "spans"
        }
      ]
    },
    {
      "id": 11,
      "type": "table",
      "title": "Print activities",
      "description": "Temporal activity spans for printing. They run inside the API process until #1060. Tempo search returns recent matches, not the slowest of the whole range: sort by Duration to find the worst of them. Needs the Tempo datasource (clusters#1596 Phase 4).",
      "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
      "gridPos": { "x": 16, "y": 18, "w": 8, "h": 8 },
      "options": { "sortBy": [{ "displayName": "Duration", "desc": true }] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
          "queryType": "traceql",
          "query": "{resource.service.name=\"scadbuddy-api\" && span.temporalActivityID != nil} | select(span.temporalWorkflowID)",
          "limit": 20,
          "spss": 3,
          "tableType": "spans"
        }
      ]
    },
    {
      "id": 12,
      "type": "row",
      "title": "Blob store and cache",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 26, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Store operations",
      "description": "Blob store calls per second by operation and outcome (ok, full, corrupt, missing).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 27, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (op, outcome) (rate(scadbuddy_store_operations_total{namespace=\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "{{op}} {{outcome}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Worker cache hit ratio",
      "description": "Piece fetches answered from the worker's local cache.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 8, "y": 27, "w": 8, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(rate(scadbuddy_worker_cache_total{namespace=\"$namespace\", result=\"hit\"}[$__rate_interval])) / sum(rate(scadbuddy_worker_cache_total{namespace=\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "hit ratio"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Store size against its caps",
      "description": "Objects and bytes in the blob store against SCADBUDDY_STORE_MAX_* (0 is no limit, hidden).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 16, "y": 27, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "max(scadbuddy_store_blobs{namespace=\"$namespace\"})",
          "legendFormat": "objects"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "max(scadbuddy_store_max_blobs{namespace=\"$namespace\"}) > 0",
          "legendFormat": "max objects"
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Store bytes",
      "description": "Bytes in the blob store by kind, against SCADBUDDY_STORE_MAX_TOTAL_BYTES.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 35, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (kind) (scadbuddy_store_bytes{namespace=\"$namespace\"})",
          "legendFormat": "{{kind}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "max(scadbuddy_store_max_bytes{namespace=\"$namespace\"}) > 0",
          "legendFormat": "max"
        }
      ]
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Worker disk",
      "description": "The worker's local piece cache, and its data directory as kubelet counts it against the emptyDir sizeLimit.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 8, "y": 35, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "max by (pod) (scadbuddy_worker_cache_bytes{namespace=\"$namespace\"})",
          "legendFormat": "cache {{pod}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "max by (pod) (scadbuddy_render_data_bytes{namespace=\"$namespace\"})",
          "legendFormat": "data dir {{pod}}"
        }
      ]
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Render key fallback",
      "description": "1 while no render key is saved and the API's store holds the full Bambuddy key (spec 2026-09-27 §9). Standalone render workers never get it, so their renders on the Bambuddy store fail until a render key is saved.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 16, "y": 35, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "max(scadbuddy_store_render_key_fallback{namespace=\"$namespace\"})",
          "legendFormat": "fallback"
        }
      ]
    },
    {
      "id": 19,
      "type": "row",
      "title": "Uploads (// file parameters)",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 43, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Stored uploads",
      "description": "Files and bytes stored for // file parameters, against their caps (0 is no limit, hidden).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 44, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "max(scadbuddy_assets_stored{namespace=\"$namespace\"})",
          "legendFormat": "files"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "max(scadbuddy_assets_max_count{namespace=\"$namespace\"}) > 0",
          "legendFormat": "max files"
        }
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Upload bytes",
      "description": "Bytes stored for // file parameters against SCADBUDDY_ASSET_MAX_TOTAL_BYTES.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 8, "y": 44, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "max(scadbuddy_assets_bytes{namespace=\"$namespace\"})",
          "legendFormat": "bytes"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "max(scadbuddy_assets_max_bytes{namespace=\"$namespace\"}) > 0",
          "legendFormat": "max"
        }
      ]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Refused and swept",
      "description": "Uploads refused (413) at a cap, and stored files the sweep removed.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 16, "y": 44, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(increase(scadbuddy_assets_rejected_total{namespace=\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "refused"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(increase(scadbuddy_assets_swept_total{namespace=\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "swept"
        }
      ]
    },
    {
      "id": 23,
      "type": "row",
      "title": "Native slicer (slicer_backend native)",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 52, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "Slice duration",
      "description": "From a native slice's start to its record (the slicer queue's wait, the prepare, Bambu Studio and the upload of its 3MF): p50 and p95 of the slices that completed, and p95 of those that failed.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 53, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(scadbuddy_native_slice_seconds_bucket{namespace=\"$namespace\", outcome=\"completed\"}[$__rate_interval])))",
          "legendFormat": "p50 completed"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(scadbuddy_native_slice_seconds_bucket{namespace=\"$namespace\", outcome=\"completed\"}[$__rate_interval])))",
          "legendFormat": "p95 completed"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(scadbuddy_native_slice_seconds_bucket{namespace=\"$namespace\", outcome=\"failed\"}[$__rate_interval])))",
          "legendFormat": "p95 failed"
        }
      ]
    },
    {
      "id": 25,
      "type": "timeseries",
      "title": "Slices",
      "description": "Native slices recorded, by outcome. A cancelled slice is one whose workflow was cancelled; a print run never cancels a slice the dialog shares.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 12, "y": 53, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (outcome) (increase(scadbuddy_native_slice_seconds_count{namespace=\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 26,
      "type": "row",
      "title": "Operations (bambuddy queue)",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 61, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 27,
      "type": "timeseries",
      "title": "Operation time",
      "description": "Print operations, the Bambuddy kinds picked by kind (the API ends their records, #5298; the list is checked against the worker's, backend/tests/test_dashboard_operation_kinds.py): from the operation's record to its end, by kind (#2295): p50 and p95 of those that succeeded, p95 of those that failed. On 2026-10-11 a save (output_create) took ~37 s.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 62, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.5, sum by (le, kind) (rate(scadbuddy_operation_duration_seconds_bucket{namespace=\"$namespace\", kind=~\"assign_tray_spool|attach_project|bambuddy_vp_create|bambuddy_vp_delete|bambuddy_vp_update|create_project|output_inbox_delete|preview_slice|project_file|register_sidebar|reprint|send|timelapse_pull\", outcome=\"succeeded\"}[$__rate_interval])))",
          "legendFormat": "p50 {{kind}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.95, sum by (le, kind) (rate(scadbuddy_operation_duration_seconds_bucket{namespace=\"$namespace\", kind=~\"assign_tray_spool|attach_project|bambuddy_vp_create|bambuddy_vp_delete|bambuddy_vp_update|create_project|output_inbox_delete|preview_slice|project_file|register_sidebar|reprint|send|timelapse_pull\", outcome=\"succeeded\"}[$__rate_interval])))",
          "legendFormat": "p95 {{kind}}"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.95, sum by (le, kind) (rate(scadbuddy_operation_duration_seconds_bucket{namespace=\"$namespace\", kind=~\"assign_tray_spool|attach_project|bambuddy_vp_create|bambuddy_vp_delete|bambuddy_vp_update|create_project|output_inbox_delete|preview_slice|project_file|register_sidebar|reprint|send|timelapse_pull\", outcome=\"failed\"}[$__rate_interval])))",
          "legendFormat": "p95 failed {{kind}}"
        }
      ]
    },
    {
      "id": 28,
      "type": "timeseries",
      "title": "Operations",
      "description": "Print operations, the Bambuddy kinds picked by kind (the API ends their records, #5298; the list is checked against the worker's, backend/tests/test_dashboard_operation_kinds.py): operations whose record ended, by kind and outcome (#2295).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 8, "y": 62, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (kind, outcome) (increase(scadbuddy_operations_finished_total{namespace=\"$namespace\", kind=~\"assign_tray_spool|attach_project|bambuddy_vp_create|bambuddy_vp_delete|bambuddy_vp_update|create_project|output_inbox_delete|preview_slice|project_file|register_sidebar|reprint|send|timelapse_pull\"}[$__rate_interval]))",
          "legendFormat": "{{kind}} {{outcome}}"
        }
      ]
    },
    {
      "id": 29,
      "type": "timeseries",
      "title": "Operations past the deadline",
      "description": "Print operations, the Bambuddy kinds picked by kind (the API ends their records, #5298; the list is checked against the worker's, backend/tests/test_dashboard_operation_kinds.py): requests the API answered 202 to follow (or 503 to send again) because the operation had not ended within the deadline, by kind (#2295). Once per request: a re-send counts again.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 16, "y": 62, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (kind) (increase(scadbuddy_operations_deferred_total{namespace=\"$namespace\", kind=~\"assign_tray_spool|attach_project|bambuddy_vp_create|bambuddy_vp_delete|bambuddy_vp_update|create_project|output_inbox_delete|preview_slice|project_file|register_sidebar|reprint|send|timelapse_pull\"}[$__rate_interval]))",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "id": 30,
      "type": "row",
      "title": "Cameras (printer camera recording, #7328)",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 70, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Segments indexed",
      "description": "Camera segments (about 4 s each) the leading recorder indexed per minute, by printer. A printer that records shows about 15 a minute; none means a gap.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 71, "w": 6, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "opm", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (printer) (rate(scadbuddy_camera_segments_indexed_total{namespace=\"$namespace\"}[$__rate_interval])) * 60",
          "legendFormat": "{{printer}}"
        }
      ]
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "Upload lag",
      "description": "Seconds from the end of the newest indexed segment to its index, by printer, from the recorder that holds the lease (a former leader keeps its last value, so the query joins on scadbuddy_camera_leader). It is set at each index: during an outage of the API or the bucket it keeps its last value, and the first indexes after the outage show the delay.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 6, "y": 71, "w": 6, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "max by (printer) (scadbuddy_camera_upload_lag_seconds{namespace=\"$namespace\"} * on (namespace, pod, printer) (scadbuddy_camera_leader{namespace=\"$namespace\"} == 1))",
          "legendFormat": "{{printer}}"
        }
      ]
    },
    {
      "id": 33,
      "type": "timeseries",
      "title": "Local backlog",
      "description": "Bytes of segments on each recorder's local disk, by printer and recorder pod, against SCADBUDDY_CAMERA_DISK_MAX_BYTES (default 2 GiB). Past the cap the oldest unuploaded segments are dropped and a gap is recorded.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 12, "y": 71, "w": 6, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (printer, pod) (scadbuddy_camera_backlog_bytes{namespace=\"$namespace\"})",
          "legendFormat": "{{printer}} {{pod}}"
        }
      ]
    },
    {
      "id": 34,
      "type": "timeseries",
      "title": "Leader per printer",
      "description": "1 while a recorder holds the printer's lease, by printer and recorder. Exactly one recorder leads each recorded printer; a handover shows as a change of recorder.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 18, "y": 71, "w": 6, "h": 8 },
      "fieldConfig": { "defaults": { "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "max by (printer, recorder) (scadbuddy_camera_leader{namespace=\"$namespace\"})",
          "legendFormat": "{{printer}} {{recorder}}"
        }
      ]
    },
    {
      "id": 35,
      "type": "timeseries",
      "title": "Relay pull",
      "description": "1 while the relay's pull of the printer's camera is ready, 0 while MediaMTX is still trying it (the relay's runOnAvailable and runOnUnavailable hooks, and its runtime list at each resync), by printer.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 79, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "max by (printer) (scadbuddy_camera_relay_pulling{namespace=\"$namespace\"})",
          "legendFormat": "{{printer}}"
        }
      ]
    },
    {
      "id": 36,
      "type": "timeseries",
      "title": "Relay reconnects",
      "description": "Times the relay's pull became ready again after it was not ready, by printer. A path the relay replaced while it was ready (a new access code or address) counts too; the first ready after a relay start does not.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 8, "y": 79, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (printer) (increase(scadbuddy_camera_relay_reconnects_total{namespace=\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "{{printer}}"
        }
      ]
    },
    {
      "id": 37,
      "type": "timeseries",
      "title": "Last segment age",
      "description": "Seconds since each recorder's last segment of the printer, set each tick (every 5 s), by printer and recorder pod. Past 120 s the leader reports the feed stalled.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 16, "y": 79, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "max by (printer, pod) (scadbuddy_camera_last_segment_age_seconds{namespace=\"$namespace\"})",
          "legendFormat": "{{printer}} {{pod}}"
        }
      ]
    }
  ]
}
