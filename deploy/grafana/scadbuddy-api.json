{
  "uid": "scadbuddy-api",
  "title": "ScadBuddy / API",
  "description": "API latency, throughput and errors per route template (scadbuddy_http_* metrics) beside Tempo searches of the slow routes. Deployed from eh-homelab/ScadBuddy deploy/grafana.",
  "tags": ["scadbuddy"],
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 42,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "1m",
  "links": [
    {
      "type": "dashboards",
      "title": "ScadBuddy",
      "tags": ["scadbuddy"],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "icon": "external link",
      "tooltip": "",
      "url": ""
    }
  ],
  "annotations": { "list": [] },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "prometheus" },
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "options": []
      },
      {
        "name": "DS_TEMPO",
        "label": "Tempo",
        "description": "Trace panels need a Tempo datasource (clusters#1596 Phase 4); until one exists they show no data and the metric panels are unaffected.",
        "type": "datasource",
        "query": "tempo",
        "current": { "text": "Tempo", "value": "tempo" },
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "options": []
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(scadbuddy_build_info, namespace)",
        "query": {
          "query": "label_values(scadbuddy_build_info, namespace)",
          "refId": "namespace"
        },
        "current": { "text": "bambuddy", "value": "bambuddy" },
        "includeAll": false,
        "hide": 0,
        "refresh": 2,
        "regex": "",
        "options": []
      },
      {
        "name": "route",
        "label": "Route",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(scadbuddy_http_requests_total{namespace=\"$namespace\"}, route)",
        "query": {
          "query": "label_values(scadbuddy_http_requests_total{namespace=\"$namespace\"}, route)",
          "refId": "route"
        },
        "includeAll": false,
        "hide": 0,
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "At a glance",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Requests/s",
      "description": "API requests per second, SPA files and 404s (route \"other\") left out.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 1, "w": 4, "h": 4 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(rate(scadbuddy_http_requests_total{namespace=\"$namespace\", route!=\"other\"}[$__rate_interval]))",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "5xx share",
      "description": "Share of API requests answered 5xx over the range.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 4, "y": 1, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(increase(scadbuddy_http_requests_total{namespace=\"$namespace\", route!=\"other\", status=~\"5..\"}[$__range])) / sum(increase(scadbuddy_http_requests_total{namespace=\"$namespace\", route!=\"other\"}[$__range]))",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Mean latency",
      "description": "Mean API request time over the range (_sum/_count, not capped at 10 s).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 8, "y": 1, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.5 },
              { "color": "red", "value": 2 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(increase(scadbuddy_http_request_duration_seconds_sum{namespace=\"$namespace\", route!=\"other\"}[$__range])) / sum(increase(scadbuddy_http_request_duration_seconds_count{namespace=\"$namespace\", route!=\"other\"}[$__range]))",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Slower than 1 s",
      "description": "Share of API requests that took over 1 s, over the range.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 12, "y": 1, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.02 },
              { "color": "red", "value": 0.1 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "1 - sum(increase(scadbuddy_http_request_duration_seconds_bucket{namespace=\"$namespace\", route!=\"other\", le=\"1.0\"}[$__range])) / sum(increase(scadbuddy_http_request_duration_seconds_count{namespace=\"$namespace\", route!=\"other\"}[$__range]))",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Slower than 5 s",
      "description": "Share of API requests that took over 5 s, over the range.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 16, "y": 1, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.005 },
              { "color": "red", "value": 0.02 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "1 - sum(increase(scadbuddy_http_request_duration_seconds_bucket{namespace=\"$namespace\", route!=\"other\", le=\"5.0\"}[$__range])) / sum(increase(scadbuddy_http_request_duration_seconds_count{namespace=\"$namespace\", route!=\"other\"}[$__range]))",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Slower than 10 s",
      "description": "API requests over 10 s in the range: past the histogram's top finite bucket.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 20, "y": 1, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(increase(scadbuddy_http_request_duration_seconds_count{namespace=\"$namespace\", route!=\"other\"}[$__range])) - sum(increase(scadbuddy_http_request_duration_seconds_bucket{namespace=\"$namespace\", route!=\"other\", le=\"10.0\"}[$__range]))",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 8,
      "type": "row",
      "title": "Slowest routes",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 5, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 9,
      "type": "table",
      "title": "Routes by mean latency over the range",
      "description": "Every route template with traffic in the range, slowest first: mean, p95 and p99 time, requests, and the share slower than 5 s and 10 s. The HTTP histogram's top finite bucket is 10 s, so a quantile above 10 s reads as 10 s; the mean (from _sum/_count) is not capped.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 6, "w": 24, "h": 10 },
      "fieldConfig": {
        "defaults": { "unit": "s", "decimals": 2 },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Requests" },
            "properties": [{ "id": "unit", "value": "short" }, { "id": "decimals", "value": 0 }]
          },
          {
            "matcher": { "id": "byName", "options": "Over 5 s" },
            "properties": [{ "id": "unit", "value": "percentunit" }]
          },
          {
            "matcher": { "id": "byName", "options": "Over 10 s" },
            "properties": [{ "id": "unit", "value": "percentunit" }]
          },
          {
            "matcher": { "id": "byName", "options": "Mean" },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": { "type": "color-background", "mode": "basic" }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "orange", "value": 1 },
                    { "color": "red", "value": 5 }
                  ]
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (method, route) (increase(scadbuddy_http_request_duration_seconds_sum{namespace=\"$namespace\", route!=\"other\"}[$__range])) / sum by (method, route) (increase(scadbuddy_http_request_duration_seconds_count{namespace=\"$namespace\", route!=\"other\"}[$__range]))",
          "legendFormat": "mean",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.95, sum by (le, method, route) (increase(scadbuddy_http_request_duration_seconds_bucket{namespace=\"$namespace\", route!=\"other\"}[$__range])))",
          "legendFormat": "p95",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.99, sum by (le, method, route) (increase(scadbuddy_http_request_duration_seconds_bucket{namespace=\"$namespace\", route!=\"other\"}[$__range])))",
          "legendFormat": "p99",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "D",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (method, route) (increase(scadbuddy_http_request_duration_seconds_count{namespace=\"$namespace\", route!=\"other\"}[$__range]))",
          "legendFormat": "requests",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "E",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "1 - sum by (method, route) (increase(scadbuddy_http_request_duration_seconds_bucket{namespace=\"$namespace\", route!=\"other\", le=\"5.0\"}[$__range])) / sum by (method, route) (increase(scadbuddy_http_request_duration_seconds_count{namespace=\"$namespace\", route!=\"other\"}[$__range]))",
          "legendFormat": "over 5 s",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "F",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "1 - sum by (method, route) (increase(scadbuddy_http_request_duration_seconds_bucket{namespace=\"$namespace\", route!=\"other\", le=\"10.0\"}[$__range])) / sum by (method, route) (increase(scadbuddy_http_request_duration_seconds_count{namespace=\"$namespace\", route!=\"other\"}[$__range]))",
          "legendFormat": "over 10 s",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "renameByName": {
              "Value #A": "Mean",
              "Value #B": "p95",
              "Value #C": "p99",
              "Value #D": "Requests",
              "Value #E": "Over 5 s",
              "Value #F": "Over 10 s"
            }
          }
        }
      ],
      "options": { "sortBy": [{ "displayName": "Mean", "desc": true }], "showHeader": true }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Mean latency, 10 slowest routes",
      "description": "Mean request time per route (_sum/_count), the ten slowest at each step; not capped.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 16, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "topk(10, sum by (method, route) (rate(scadbuddy_http_request_duration_seconds_sum{namespace=\"$namespace\", route!=\"other\"}[$__rate_interval])) / sum by (method, route) (rate(scadbuddy_http_request_duration_seconds_count{namespace=\"$namespace\", route!=\"other\"}[$__rate_interval])))",
          "legendFormat": "{{method}} {{route}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "p95 by route",
      "description": "p95 request time per route. The HTTP histogram's top finite bucket is 10 s, so a quantile above 10 s reads as 10 s; the mean (from _sum/_count) is not capped.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 8, "y": 16, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "topk(10, histogram_quantile(0.95, sum by (le, method, route) (rate(scadbuddy_http_request_duration_seconds_bucket{namespace=\"$namespace\", route!=\"other\"}[$__rate_interval]))))",
          "legendFormat": "{{method}} {{route}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "p99 by route",
      "description": "p99 request time per route. The HTTP histogram's top finite bucket is 10 s, so a quantile above 10 s reads as 10 s; the mean (from _sum/_count) is not capped.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 16, "y": 16, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "topk(10, histogram_quantile(0.99, sum by (le, method, route) (rate(scadbuddy_http_request_duration_seconds_bucket{namespace=\"$namespace\", route!=\"other\"}[$__rate_interval]))))",
          "legendFormat": "{{method}} {{route}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "p50 / p95 / p99, all routes",
      "description": "Request time over every API route together. The HTTP histogram's top finite bucket is 10 s, so a quantile above 10 s reads as 10 s; the mean (from _sum/_count) is not capped.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 24, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.5, sum by (le, namespace) (rate(scadbuddy_http_request_duration_seconds_bucket{namespace=\"$namespace\", route!=\"other\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.95, sum by (le, namespace) (rate(scadbuddy_http_request_duration_seconds_bucket{namespace=\"$namespace\", route!=\"other\"}[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.99, sum by (le, namespace) (rate(scadbuddy_http_request_duration_seconds_bucket{namespace=\"$namespace\", route!=\"other\"}[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Requests by route",
      "description": "Requests per second per route, the ten busiest.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 8, "y": 24, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "topk(10, sum by (method, route) (rate(scadbuddy_http_requests_total{namespace=\"$namespace\", route!=\"other\"}[$__rate_interval])))",
          "legendFormat": "{{method}} {{route}}"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Requests by status",
      "description": "Requests per second by status code.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 16, "y": 24, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (status) (rate(scadbuddy_http_requests_total{namespace=\"$namespace\", route!=\"other\"}[$__rate_interval]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 16,
      "type": "row",
      "title": "Slow list and media endpoints (#2289)",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 32, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Mean latency",
      "description": "The list and media routes found slow on 2026-10-11 (#2289): mean request time (not capped).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 33, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (method, route) (rate(scadbuddy_http_request_duration_seconds_sum{namespace=\"$namespace\", route!=\"other\", route=~\"(/api/v1)?(/models|/prints|/models/{slug}/outputs|/prints/{archive_id}/photos/{filename}|/prints/{archive_id}/thumbnail|/models/{slug}/media/{item_id}/thumbnail)\"}[$__rate_interval])) / sum by (method, route) (rate(scadbuddy_http_request_duration_seconds_count{namespace=\"$namespace\", route!=\"other\", route=~\"(/api/v1)?(/models|/prints|/models/{slug}/outputs|/prints/{archive_id}/photos/{filename}|/prints/{archive_id}/thumbnail|/models/{slug}/media/{item_id}/thumbnail)\"}[$__rate_interval]))",
          "legendFormat": "{{method}} {{route}}"
        }
      ]
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Share slower than 5 s",
      "description": "Of each of those routes' requests, the share over 5 s.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 12, "y": 33, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
