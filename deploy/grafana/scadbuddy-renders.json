{
  "uid": "scadbuddy-renders",
  "title": "ScadBuddy / Renders, Arrange and Temporal",
  "description": "The render queue, Arrange/backfill/save, and the Temporal worker's activities: Prometheus metrics beside Tempo searches. Known gaps: #2291, #2292.",
  "tags": ["scadbuddy"],
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 42,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "1m",
  "links": [
    {
      "type": "dashboards",
      "title": "ScadBuddy",
      "tags": ["scadbuddy"],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "icon": "external link",
      "tooltip": "",
      "url": ""
    }
  ],
  "annotations": { "list": [] },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "prometheus" },
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "options": []
      },
      {
        "name": "DS_TEMPO",
        "label": "Tempo",
        "description": "Trace panels need a Tempo datasource (clusters#1596 Phase 4); until one exists they show no data and the metric panels are unaffected.",
        "type": "datasource",
        "query": "tempo",
        "current": { "text": "Tempo", "value": "tempo" },
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "options": []
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(scadbuddy_build_info, namespace)",
        "query": {
          "query": "label_values(scadbuddy_build_info, namespace)",
          "refId": "namespace"
        },
        "current": { "text": "bambuddy", "value": "bambuddy" },
        "includeAll": false,
        "hide": 0,
        "refresh": 2,
        "regex": "",
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Queue",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Submitted by kind",
      "description": "New jobs accepted per second, coalesced onto a waiting identical job, and refused (queue full), by kind (render, arrange).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 1, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (kind) (rate(scadbuddy_render_jobs_submitted_total{namespace=\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "submitted {{kind}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (kind) (rate(scadbuddy_render_jobs_coalesced_total{namespace=\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "coalesced {{kind}}"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (kind) (rate(scadbuddy_render_jobs_rejected_total{namespace=\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "rejected {{kind}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Still accepting (503)",
      "description": "Requests answered 503 command-still-accepting: their job was not answered in time and the client re-sends. On 2026-10-11 Arrange backfills spent ~17.7 s before this answer.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 8, "y": 1, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(increase(scadbuddy_render_accept_pending_total{namespace=\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "503 still accepting"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Queue",
      "description": "Jobs waiting for a worker and jobs being worked on.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 16, "y": 1, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "max(scadbuddy_render_queue_depth{namespace=\"$namespace\"})",
          "legendFormat": "waiting"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "max(scadbuddy_render_jobs_running{namespace=\"$namespace\"})",
          "legendFormat": "running"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "max(scadbuddy_render_queue_oldest_seconds{namespace=\"$namespace\"})",
          "legendFormat": "oldest wait (s)"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Queue wait",
      "description": "Submit until the workflow began the render.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 9, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(scadbuddy_render_queue_wait_seconds_bucket{namespace=\"$namespace\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(scadbuddy_render_queue_wait_seconds_bucket{namespace=\"$namespace\"}[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Render time by outcome",
      "description": "Time a worker spent on a job (render and arrange together; no kind label yet).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 8, "y": 9, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.5, sum by (le, outcome) (rate(scadbuddy_render_duration_seconds_bucket{namespace=\"$namespace\"}[$__rate_interval])))",
          "legendFormat": "p50 {{outcome}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.95, sum by (le, outcome) (rate(scadbuddy_render_duration_seconds_bucket{namespace=\"$namespace\"}[$__rate_interval])))",
          "legendFormat": "p95 {{outcome}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Outcomes",
      "description": "Jobs leaving the queue per second, by outcome.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 16, "y": 9, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (outcome) (rate(scadbuddy_render_jobs_finished_total{namespace=\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "{{outcome}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(rate(scadbuddy_render_jobs_retried_total{namespace=\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "retried"
        }
      ]
    },
    {
      "id": 8,
      "type": "row",
      "title": "Arrange, backfill and save",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 17, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Mean latency",
      "description": "Arrange (POST /outputs/arrange), backfill (POST /outputs/{output_id}/backfill), save (POST /models/{slug}/outputs) and the operation polls that follow a 202. On 2026-10-11 a backfill took ~17.7 s then 503'd; a save with its polling ~37 s.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 18, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (method, route) (rate(scadbuddy_http_request_duration_seconds_sum{namespace=\"$namespace\", route!=\"other\", route=~\"(/api/v1)?(/outputs/arrange|/outputs/{output_id}/backfill|/models/{slug}/outputs|/operations/{operation_id})\"}[$__rate_interval])) / sum by (method, route) (rate(scadbuddy_http_request_duration_seconds_count{namespace=\"$namespace\", route!=\"other\", route=~\"(/api/v1)?(/outputs/arrange|/outputs/{output_id}/backfill|/models/{slug}/outputs|/operations/{operation_id})\"}[$__rate_interval]))",
          "legendFormat": "{{method}} {{route}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Responses by status",
      "description": "Those routes' responses per second by status: 503 is command-still-accepting, 202 an operation still running.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 8, "y": 18, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (method, route, status) (rate(scadbuddy_http_requests_total{namespace=\"$namespace\", route!=\"other\", route=~\"(/api/v1)?(/outputs/arrange|/outputs/{output_id}/backfill|/models/{slug}/outputs|/operations/{operation_id})\"}[$__rate_interval]))",
          "legendFormat": "{{status}} {{method}} {{route}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Arrange jobs",
      "description": "Arrange jobs submitted per second against renders. Their duration is not split from renders' (no kind label on the duration histograms).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 16, "y": 18, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (kind) (rate(scadbuddy_render_jobs_submitted_total{namespace=\"$namespace\", kind=\"arrange\"}[$__rate_interval]))",
          "legendFormat": "submitted {{kind}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (kind) (rate(scadbuddy_render_jobs_coalesced_total{namespace=\"$namespace\", kind=\"arrange\"}[$__rate_interval]))",
          "legendFormat": "coalesced {{kind}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "table",
      "title": "POST /outputs/arrange",
      "description": "Arrange requests. The arranged render that follows is untraced while #2291 leaves the browser's request unsampled. Tempo search returns recent matches, not the slowest of the whole range: sort by Duration to find the worst of them. Needs the Tempo datasource (clusters#1596 Phase 4).",
      "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
      "gridPos": { "x": 0, "y": 26, "w": 8, "h": 8 },
      "options": { "sortBy": [{ "displayName": "Duration", "desc": true }] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
          "queryType": "traceql",
          "query": "{resource.service.name=\"scadbuddy-api\" && kind=server && span.http.route=\"/api/v1/outputs/arrange\" && span.http.method=\"POST\"} | select(span.http.method, span.http.status_code)",
          "limit": 20,
          "spss": 3,
          "tableType": "traces"
        }
      ]
    },
    {
      "id": 13,
      "type": "table",
      "title": "POST /outputs/{output_id}/backfill",
      "description": "Backfill requests, with the 503 command-still-accepting answers among them. Tempo search returns recent matches, not the slowest of the whole range: sort by Duration to find the worst of them. Needs the Tempo datasource (clusters#1596 Phase 4).",
      "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
      "gridPos": { "x": 8, "y": 26, "w": 8, "h": 8 },
      "options": { "sortBy": [{ "displayName": "Duration", "desc": true }] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
          "queryType": "traceql",
          "query": "{resource.service.name=\"scadbuddy-api\" && kind=server && span.http.route=\"/api/v1/outputs/{output_id}/backfill\" && span.http.method=\"POST\"} | select(span.http.method, span.http.status_code)",
          "limit": 20,
          "spss": 3,
          "tableType": "traces"
        }
      ]
    },
    {
      "id": 14,
      "type": "table",
      "title": "POST /models/{slug}/outputs",
      "description": "Saving an output: the operation's start. Its polling is the next panel. Not traced end to end until #2292. Tempo search returns recent matches, not the slowest of the whole range: sort by Duration to find the worst of them. Needs the Tempo datasource (clusters#1596 Phase 4).",
      "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
      "gridPos": { "x": 16, "y": 26, "w": 8, "h": 8 },
      "options": { "sortBy": [{ "displayName": "Duration", "desc": true }] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
          "queryType": "traceql",
          "query": "{resource.service.name=\"scadbuddy-api\" && kind=server && span.http.route=\"/api/v1/models/{slug}/outputs\" && span.http.method=\"POST\"} | select(span.http.method, span.http.status_code)",
          "limit": 20,
          "spss": 3,
          "tableType": "traces"
        }
      ]
    },
    {
      "id": 15,
      "type": "table",
      "title": "GET /operations/{operation_id}",
      "description": "Operation polls (a save or another command past its deadline). Tempo search returns recent matches, not the slowest of the whole range: sort by Duration to find the worst of them. Needs the Tempo datasource (clusters#1596 Phase 4).",
      "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
      "gridPos": { "x": 0, "y": 34, "w": 12, "h": 8 },
      "options": { "sortBy": [{ "displayName": "Duration", "desc": true }] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
          "queryType": "traceql",
          "query": "{resource.service.name=\"scadbuddy-api\" && kind=server && span.http.route=\"/api/v1/operations/{operation_id}\" && span.http.method=\"GET\"} | select(span.http.method, span.http.status_code)",
          "limit": 20,
          "spss": 3,
          "tableType": "traces"
        }
      ]
    },
    {
      "id": 16,
      "type": "table",
      "title": "Render submits",
      "description": "render.submit spans: the API inserting a job and starting (or joining) its workflow; scadbuddy.coalesced says which. Tempo search returns recent matches, not the slowest of the whole range: sort by Duration to find the worst of them. Needs the Tempo datasource (clusters#1596 Phase 4).",
      "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
      "gridPos": { "x": 12, "y": 34, "w": 12, "h": 8 },
      "options": { "sortBy": [{ "displayName": "Duration", "desc": true }] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
          "queryType": "traceql",
          "query": "{resource.service.name=\"scadbuddy-api\" && name=\"render.submit\"} | select(span.scadbuddy.coalesced, span.scadbuddy.failure_class)",
          "limit": 20,
          "spss": 3,
          "tableType": "spans"
        }
      ]
    },
    {
      "id": 17,
      "type": "row",
      "title": "Temporal and the worker",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 42, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Stage time (p95)",
      "description": "Time in each render stage.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 43, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(scadbuddy_render_stage_seconds_bucket{namespace=\"$namespace\"}[$__rate_interval])))",
          "legendFormat": "{{stage}}"
        }
      ]
    },
    {
      "id": 19,
      "type": "table",
      "title": "Slowest activities",
      "description": "Temporal activity spans on the worker (the TracingInterceptor's, marked by temporalActivityID). Render and print workers both report as scadbuddy-worker until #2292. Tempo search returns recent matches, not the slowest of the whole range: sort by Duration to find the worst of them. Needs the Tempo datasource (clusters#1596 Phase 4).",
      "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
      "gridPos": { "x": 8, "y": 43, "w": 8, "h": 8 },
      "options": { "sortBy": [{ "displayName": "Duration", "desc": true }] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
          "queryType": "traceql",
          "query": "{resource.service.name=\"scadbuddy-worker\" && span.temporalActivityID != nil} | select(span.temporalWorkflowID)",
          "limit": 20,
          "spss": 3,
          "tableType": "spans"
        }
      ]
    },
    {
      "id": 20,
      "type": "table",
      "title": "Failed workflow and activity spans",
      "description": "Temporal spans on the worker with status error. Tempo search returns recent matches, not the slowest of the whole range: sort by Duration to find the worst of them. Needs the Tempo datasource (clusters#1596 Phase 4).",
      "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
      "gridPos": { "x": 16, "y": 43, "w": 8, "h": 8 },
      "options": { "sortBy": [{ "displayName": "Duration", "desc": true }] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
          "queryType": "traceql",
          "query": "{resource.service.name=\"scadbuddy-worker\" && status=error && span.temporalWorkflowID != nil} | select(span.temporalActivityID, span.scadbuddy.failure_class)",
          "limit": 20,
          "spss": 3,
          "tableType": "spans"
        }
      ]
    },
    {
      "id": 21,
      "type": "table",
      "title": "openscad.export (worker)",
      "description": "Every openscad pass on the worker, slowest first; the exit code tells a timeout or a crash. Tempo search returns recent matches, not the slowest of the whole range: sort by Duration to find the worst of them. Needs the Tempo datasource (clusters#1596 Phase 4).",
      "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
      "gridPos": { "x": 0, "y": 51, "w": 8, "h": 8 },
      "options": { "sortBy": [{ "displayName": "Duration", "desc": true }] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
          "queryType": "traceql",
          "query": "{resource.service.name=\"scadbuddy-worker\" && name=\"openscad.export\"} | select(span.scadbuddy.openscad.exit_code, span.scadbuddy.failure_class)",
          "limit": 20,
          "spss": 3,
          "tableType": "spans"
        }
      ]
    },
    {
      "id": 22,
      "type": "table",
      "title": "Per-colour solids",
      "description": "render.solid: one re-render per colour; scadbuddy.solid.fallback marks one that fell back. Tempo search returns recent matches, not the slowest of the whole range: sort by Duration to find the worst of them. Needs the Tempo datasource (clusters#1596 Phase 4).",
      "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
      "gridPos": { "x": 8, "y": 51, "w": 8, "h": 8 },
      "options": { "sortBy": [{ "displayName": "Duration", "desc": true }] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
          "queryType": "traceql",
          "query": "{resource.service.name=\"scadbuddy-worker\" && name=\"render.solid\"} | select(span.scadbuddy.solid.fallback, span.scadbuddy.failure_class)",
          "limit": 20,
          "spss": 3,
          "tableType": "spans"
        }
      ]
    },
    {
      "id": 23,
      "type": "table",
      "title": "Previews",
      "description": "render.preview spans on the worker. Tempo search returns recent matches, not the slowest of the whole range: sort by Duration to find the worst of them. Needs the Tempo datasource (clusters#1596 Phase 4).",
      "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
      "gridPos": { "x": 16, "y": 51, "w": 8, "h": 8 },
      "options": { "sortBy": [{ "displayName": "Duration", "desc": true }] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
          "queryType": "traceql",
          "query": "{resource.service.name=\"scadbuddy-worker\" && name=\"render.preview\"}",
          "limit": 20,
          "spss": 3,
          "tableType": "traces"
        }
      ]
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "API and worker spans per second",
      "description": "Spans Tempo holds per second, one series per service, so a service that stops reporting shows as a gap. Known gaps, not health: parentless browser fetches are never sampled (#2291), so page loads after the first and every render or arrange they start have no trace; Arrange, backfill and save are not traceAction'd (#2292); render and print workers both report as scadbuddy-worker (#2292). A TraceQL metrics query: it needs Tempo's metrics-generator local-blocks processor (clusters#1596, spec 2026-10-01 §7). Without it this panel is empty, which means not configured, not zero traces.",
      "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
      "gridPos": { "x": 0, "y": 59, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
          "queryType": "traceql",
          "metricsQueryType": "range",
          "query": "{resource.service.name=\"scadbuddy-api\"} | rate()",
          "legendFormat": "scadbuddy-api",
          "limit": 20
        },
        {
          "refId": "B",
          "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
          "queryType": "traceql",
          "metricsQueryType": "range",
          "query": "{resource.service.name=\"scadbuddy-worker\"} | rate()",
          "legendFormat": "scadbuddy-worker",
          "limit": 20
        }
      ]
    },
    {
      "id": 25,
      "type": "row",
      "title": "Queue health",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 67, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 26,
      "type": "timeseries",
      "title": "Job store",
      "description": "1 while the per-scrape read of render_jobs works; failed render_jobs calls by operation.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 68, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "min(scadbuddy_render_store_up{namespace=\"$namespace\"})",
          "legendFormat": "store up"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (operation) (increase(scadbuddy_render_store_errors_total{namespace=\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "errors {{operation}}"
        }
      ]
    },
    {
      "id": 27,
      "type": "timeseries",
      "title": "Settle passes",
      "description": "Jobs a settle pass failed because nothing would settle them, and passes that stopped early, by pass.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 8, "y": 68, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (pass) (increase(scadbuddy_render_settle_failed_total{namespace=\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "failed {{pass}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (pass) (increase(scadbuddy_render_settle_errors_total{namespace=\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "errors {{pass}}"
        }
      ]
    },
    {
      "id": 28,
      "type": "timeseries",
      "title": "Event bus",
      "description": "LISTEN connection state and reconnects; events published, received and dropped by reason.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 16, "y": 68, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "min(scadbuddy_render_queue_listener_connected{namespace=\"$namespace\"})",
          "legendFormat": "listener up"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(increase(scadbuddy_render_queue_listener_reconnects_total{namespace=\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "reconnects"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(rate(scadbuddy_events_published_total{namespace=\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "published/s"
        },
        {
          "refId": "D",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(rate(scadbuddy_events_received_total{namespace=\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "received/s"
        },
        {
          "refId": "E",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (reason) (increase(scadbuddy_events_dropped_total{namespace=\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "dropped {{reason}}"
        }
      ]
    }
