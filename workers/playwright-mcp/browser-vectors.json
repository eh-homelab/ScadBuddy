{
  "about": "A session's browser options (#7027): the bounds the API (tools/go/core/internal/sessions) and the playwright-mcp wrapper (options.mjs) both hold, and values each must take or refuse. the Go tests in tools/go/core and options.test.mjs check their own constants and checks against this file.",
  "bounds": {
    "user_agent_pattern": "^[\\x20-\\x7E]{1,512}$",
    "locale_pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$",
    "locale_max": 35,
    "viewport_width": [
      320,
      3840
    ],
    "viewport_height": [
      320,
      2160
    ]
  },
