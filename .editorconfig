root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.{scad,md}]
# Markdown uses two trailing spaces for a hard line break, and .scad files are
# data as much as code — neither should have whitespace rewritten under them.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[agent/src/db/migrations/*.sql]
# The agent records each migration file's SHA-256 and refuses to start when an
# applied one changes (agent/src/db/migrations.ts), so no whitespace is ever
# rewritten under them. The first two hold their pre-#491 SQL byte for byte.
trim_trailing_whitespace = false
insert_final_newline = false
