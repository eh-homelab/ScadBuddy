# The build context is the repo root (the Dockerfile's Node stage needs
# frontend/, the runtime stage needs backend/ and models/, the agent stages
# need agent/, and agent-build also copies plugins/scadbuddy/skills and
# agents, which agent/plugins/scadbuddy links to (#896) and get_authoring_guide
# serves from, #252). Everything that is not one of those is noise that
# invalidates layers; do not exclude plugins/ without those.

.git
.gitignore
.github
.claude
.claude-worktrees
docs
# Real 3MFs from MakerWorld (Git LFS, ~290 MB): CI mounts them into the test
# container read-only, so no image carries them (backend/tests/support/fixtures.py).
test-fixtures

# Build output that MUST come from the Node stage, never from the host — a
# stale local dist silently shipping instead of a fresh build is the whole
# reason this entry exists.
frontend/dist
frontend/node_modules
frontend/.vite
frontend/playwright-report
frontend/test-results
frontend/coverage
agent/dist
agent/node_modules
agent/coverage
node_modules
# Cargo's build output (gigabytes on a dev host).
workers/rust/target

# Python build/test detritus. .venv in particular: a host venv has absolute
# paths and the wrong interpreter, and copying it over the image's /opt/venv
# would produce an image that works nowhere else.
backend/.venv
backend/.pytest_cache
backend/.mypy_cache
backend/.ruff_cache
backend/htmlcov
backend/.coverage
**/__pycache__
**/*.py[cod]

# Editor / OS
.editorconfig
.vscode
.idea
.DS_Store
*.swp

Dockerfile
.dockerignore
LICENSE
README.md

# pytest-split's timings (#1167): CI mounts the file into each shard, so a
# refresh does not invalidate the test image's `COPY backend/` layer.
backend/.test_durations
