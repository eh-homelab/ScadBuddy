<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ScadBuddy.MainPage"
             Title="ScadBuddy">
    <ContentPage.ToolbarItems>
        <ToolbarItem x:Name="TasksItem" Text="Tasks" Clicked="OnTasksClicked" />
        <ToolbarItem Text="Server" Clicked="OnServerClicked" />
        <ToolbarItem Text="Reload" Clicked="OnReloadClicked" />
        <ToolbarItem Text="Telemetry" Order="Secondary" Clicked="OnTelemetryClicked" />
    </ContentPage.ToolbarItems>
    <WebView x:Name="Web" />
</ContentPage>
