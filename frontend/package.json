{
  "name": "scadbuddy-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "pretypecheck": "pnpm gen:api",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "pretest": "pnpm gen:api",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "gen:api": "node scripts/gen-api.mjs",
    "check:storefront-bundle": "node scripts/check-storefront-bundle.mjs dist"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/core": "3.1.1",
    "@opentelemetry/instrumentation": "0.301.2",
    "@opentelemetry/instrumentation-document-load": "0.70.1",
    "@opentelemetry/instrumentation-fetch": "0.301.2",
    "@opentelemetry/otlp-transformer": "0.301.2",
    "@opentelemetry/resources": "3.1.1",
    "@opentelemetry/sdk-trace": "3.1.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "embla-carousel-react": "^8.6.0",
    "hls.js": "1.7.4",
    "lucide-react": "1.80.0",
    "modern-screenshot": "^4.7.0",
    "monaco-editor": "^0.58.0",
    "qrcode": "1.5.4",
    "radix-ui": "1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-remove-scroll": "2.7.2",
    "react-router": "^8.5.3",
    "tailwind-merge": "3.7.1",
    "three": "^0.187.0",
    "tw-animate-css": "1.4.0",
    "yet-another-react-lightbox": "^3.33.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^26.6.7",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "msw": "^3.0.7",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
