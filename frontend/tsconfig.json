{
  "files": [],
  // Read by the shadcn CLI (components.json) to resolve `@/`; tsconfig.app.json has the same.
  "compilerOptions": {
    "paths": {
      "@/components/ui/button": ["./src/components/ui/shadcn-button.tsx"],
      "@/components/ui/dialog": ["./src/components/ui/shadcn-dialog.tsx"],
      "@/*": ["./src/*"]
    }
  },
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" }
  ]
}
